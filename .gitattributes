# Forzar LF en todos los scripts de shell Unix y archivos de texto plano
* text=auto eol=lf
*.sh text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf

# Mantener CRLF solo en archivos batch de Windows si es necesario
# .bat se guarda TAL CUAL con CRLF: GitHub raw lo sirve asi y cmd.exe no falla con los goto/etiquetas
*.bat -text
*.ps1 text eol=crlf
