# ==============================================================================
# NOVA AGENT CORE - CONFIGURACION DE CLAVES & SERVICIOS (PLANTILLA BASE)
# Ubicacion destino recomendada: ~/.gemini/config/secrets.env
# ==============================================================================
# Todas las claves son 100% GRATUITAS (0,00 €) y NO requieren tarjeta de credito.
# Copia este archivo a ~/.gemini/config/secrets.env o define las variables en tu OS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ROUTER MULTI-MODELO GRATUITO (DeepSeek R1, Llama 3, Qwen Coder a 0€)
# ------------------------------------------------------------------------------
# Obten tu clave gratuita en: https://openrouter.ai/keys (Login con Google o GitHub)
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. AUDIO & TRANSCRIPCION ULTRA-RAPIDA DE CLASES (Whisper Large v3 a 0€)
# ------------------------------------------------------------------------------
# Obten tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 3. ESPECIALISTA EN CODIGO LIMPIO & REVIEWS (Codestral Free Tier)
# ------------------------------------------------------------------------------
# Obten tu clave gratuita en: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 4. YOUTUBE DATA API V3 A COSTE CERO DE TOKENS (Busqueda y control de audio)
# ------------------------------------------------------------------------------
# Obten tu clave gratuita en: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 5. GMAIL API / IMAP PRIVADO (Lectura y filtrado de correos a 0 tokens de navegador)
# ------------------------------------------------------------------------------
# Genera tu contraseña de aplicacion de 16 letras en: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 6. SUPABASE BAAS & DATABASE (Opcional para proyectos fullstack)
# ------------------------------------------------------------------------------
# Obten tu clave de servicio en: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=
